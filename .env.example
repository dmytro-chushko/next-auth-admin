# Copy to `.env` and fill real values. Never commit `.env`.

# PostgreSQL (local)
DATABASE_URL="postgresql://dev_admin:PASSWORD@localhost:5432/next_auth_admin?schema=public"

# Better Auth (used from stage B; generated/ensured during A for CLI schema generate)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Prisma seed (stage A)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!ChangeMe"
SEED_USER_EMAIL="user@example.com"
SEED_USER_PASSWORD="User123!ChangeMe"

# Resend (stage C — email verification)
RESEND_API_KEY=
EMAIL_FROM="Next Auth Admin <onboarding@resend.dev>"
